# Copy to .env and fill in. .env is git-ignored: never commit the password.

# "memory" runs everything in one process with no external broker (default).
# "http" uses the shared Redpanda broker below.
BROKER=memory

BROKER_URL=https://edp-broker.codewithpeter.com
BROKER_USER=team2
BROKER_PASSWORD=

# Gives you your own set of topics (team2.<ns>.*) so teammates running locally
# against the shared broker do not see each other's games. Leave empty for the shared demo.
TOPIC_NS=

# "single" (default) sends every topic over team2.events, because the shared broker does not
# create new topics. Use "multi" for one real broker topic per key.
BROKER_TOPICS=single

PORT=3000
