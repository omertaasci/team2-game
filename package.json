{
  "name": "team2-game",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Christmas Quest: an event-driven 2D multiplayer co-op RPG",
  "scripts": {
    "dev": "concurrently -k -n server,client -c blue,green \"tsx watch server.ts\" \"vite\"",
    "build": "vite build",
    "start": "npm run build && tsx server.ts",
    "server": "tsx server.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "smoke:http": "tsx tests/smoke-http.ts"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "socket.io": "^4.8.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.0",
    "concurrently": "^9.1.0",
    "phaser": "^3.88.2",
    "socket.io-client": "^4.8.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.3",
    "vitest": "^2.1.8"
  }
}
